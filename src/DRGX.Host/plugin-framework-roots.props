<Project>

  <!--
    ============================================================================
    插件依赖的框架程序集闭包 —— 裁剪(self-contained + PublishTrimmed)时必须保留。

    ★ 本文件由 .workbuddy/plugin-framework-refs.cs **自动生成,不要手改**。
      插件新增框架依赖后请重跑:
        dotnet run .workbuddy/plugin-framework-refs.cs artifacts/plugins -o src/DRGX.Host/plugin-framework-roots.props

    为什么要它、代价是多少、为什么必须是传递闭包:见那个脚本的头部注释。
    一句话:插件是运行期加载的,trimmer 看不见它们,会把插件要用的类型裁掉,而崩溃
    发生在"用到该类型的那一刻"且异常消息常为空 —— 靠逐个试错是不可维护的,
    所以这里保留**健全**的闭包(比裸裁剪只贵约 2.8 MB,而未裁剪要贵 32 MB)。
    ============================================================================
  -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Microsoft.Win32.Primitives" />
    <TrimmerRootAssembly Include="Microsoft.Win32.Registry" />
    <TrimmerRootAssembly Include="mscorlib" />
    <TrimmerRootAssembly Include="netstandard" />
    <TrimmerRootAssembly Include="System.Buffers" />
    <TrimmerRootAssembly Include="System.Collections" />
    <TrimmerRootAssembly Include="System.Collections.Concurrent" />
    <TrimmerRootAssembly Include="System.Collections.Immutable" />
