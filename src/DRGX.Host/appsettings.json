{
  // ==========================================================================
  //  DRGX 运行配置 —— 与 DRGX.exe 同级,随发布包分发。
  //
  //  改这里的值不需要重新编译,也不需要安装任何东西。优先级(高 → 低):
  //    命令行  >  环境变量  >  本文件  >  程序内置默认值
  //  环境变量的写法是把冒号写成双下划线:Drgx__Port、Logging__LogLevel__Default。
  //
  //  改端口只改本文件一处即可:scripts\start-web.bat 不自己存端口,它会向
  //  DRGX.exe --print-config 问当前生效值,所以本文件与启动器不会对不上。
  //
  //  每个字段的用法与排障见同目录 README.md。本文件不含任何口令:HIS 连接串
  //  这类敏感值放 configs\his\*.local.json(不随包发布)或环境变量,不要写进来。
  // ==========================================================================

  "Drgx": {
    // 监听端口。命令行 --port 会盖掉它。
    "Port": 8080,

    // 监听地址。默认仅本机 —— 本服务没有账号体系,/api/his/* 会返回患者姓名、
    // 病案号与费用。确需全网卡监听填 0.0.0.0,并确保前面有带认证的反向代理。
    "Listen": "127.0.0.1",

    // 数据包目录(相对路径按 exe 同级解释)。
    "PackPath": "data/packs/chs-drg-3.0",

    // 地区费用包根目录:启动时自动扫描 <根>\<地区>\<版本>\。
    // 随包的周口包是参考值(非当地公布值),界面上标注「演示数据 · 非本地值」。
    "RegionsRoot": "data/regions",

    // 地区包热更新轮询间隔(秒),0 = 关闭。改 data\regions 下的内容后无需重启。
    "RegionsReloadSeconds": 30,

    // 插件根目录(费用算法与 HIS 提取插件所在目录,随包附带)。
    // 留空 = 用 exe 同级的 plugins\ 目录;只有把插件挪到别处才需要填。
    "PluginsRoot": "",

    // true = 不加载任何插件:费用估算与 HIS 提取不可用,分组功能不受影响。
    "NoPlugins": false,

    // HIS 病案提取配置(json)。留空 = 自动探测 configs\his\*.local.json(放好即启用);
    // 探测不到就不启用,/api/his/* 返回 503,分组与费用功能不受影响。
    // 这里只放"路径"不放连接串:真实连接串在 healthone-1.local.json 里,不随包分发。
    // 双击 DRGX.exe 与跑 scripts\start-web.bat 行为一致,不必再靠启动器代传 --his。
    "HisConfig": ""
  },

  // 日志级别(标准 ASP.NET Core 键)。运维在"日志太多/太少"时改这里,不必碰代码。
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning"
    }
  }
}
